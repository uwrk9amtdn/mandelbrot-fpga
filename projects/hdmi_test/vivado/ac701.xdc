create_clock -period 5.000 -name clk_p [get_ports clk_p]

set_property PACKAGE_PIN R3     [get_ports clk_p]
set_property IOSTANDARD LVDS_25 [get_ports clk_p]
set_property PACKAGE_PIN P3     [get_ports clk_n]
set_property IOSTANDARD LVDS_25 [get_ports clk_n]

#HDMI
set_property PACKAGE_PIN V22        [get_ports {r[7]}]
set_property IOSTANDARD LVCMOS18    [get_ports {r[7]}]
set_property PACKAGE_PIN Y23        [get_ports {r[6]}]
set_property IOSTANDARD LVCMOS18    [get_ports {r[6]}]
set_property PACKAGE_PIN Y22        [get_ports {r[5]}]
set_property IOSTANDARD LVCMOS18    [get_ports {r[5]}]
set_property PACKAGE_PIN AB24       [get_ports {r[4]}]
set_property IOSTANDARD LVCMOS18    [get_ports {r[4]}]
set_property PACKAGE_PIN AC24       [get_ports {r[3]}]
set_property IOSTANDARD LVCMOS18    [get_ports {r[3]}]
set_property PACKAGE_PIN AB25       [get_ports {r[2]}]
set_property IOSTANDARD LVCMOS18    [get_ports {r[2]}]
set_property PACKAGE_PIN AA25       [get_ports {r[1]}]
set_property IOSTANDARD LVCMOS18    [get_ports {r[1]}]
set_property PACKAGE_PIN AA23       [get_ports {r[0]}]
set_property IOSTANDARD LVCMOS18    [get_ports {r[0]}]

set_property PACKAGE_PIN V23        [get_ports {g[7]}]
