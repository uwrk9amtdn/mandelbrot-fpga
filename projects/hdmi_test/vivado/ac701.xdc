set_property IOSTANDARD LVCMOS18    [get_ports {g[1]}]
set_property PACKAGE_PIN U25        [get_ports {g[0]}]
set_property IOSTANDARD LVCMOS18    [get_ports {g[0]}]

set_property PACKAGE_PIN U26        [get_ports {b[7]}]
set_property IOSTANDARD LVCMOS18    [get_ports {b[7]}]
set_property PACKAGE_PIN W24        [get_ports {b[6]}]
set_property IOSTANDARD LVCMOS18    [get_ports {b[6]}]
set_property PACKAGE_PIN W25        [get_ports {b[5]}]
set_property IOSTANDARD LVCMOS18    [get_ports {b[5]}]
