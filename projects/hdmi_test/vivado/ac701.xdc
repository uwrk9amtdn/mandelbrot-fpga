set_property IOSTANDARD LVCMOS18    [get_ports {g[5]}]
set_property PACKAGE_PIN W20        [get_ports {g[4]}]
set_property IOSTANDARD LVCMOS18    [get_ports {g[4]}]
set_property PACKAGE_PIN W23        [get_ports {g[3]}]
set_property IOSTANDARD LVCMOS18    [get_ports {g[3]}]
set_property PACKAGE_PIN U20        [get_ports {g[2]}]
set_property IOSTANDARD LVCMOS18    [get_ports {g[2]}]
