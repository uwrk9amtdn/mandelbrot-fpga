set_property PACKAGE_PIN AB26    [get_ports de]
set_property IOSTANDARD LVCMOS18 [get_ports de]

set_property PACKAGE_PIN AC26    [get_ports vsync]
set_property IOSTANDARD LVCMOS18 [get_ports vsync]

set_property PACKAGE_PIN AA22    [get_ports hsync]
set_property IOSTANDARD LVCMOS18 [get_ports hsync]

set_property PACKAGE_PIN V21     [get_ports pixel_clk]
set_property IOSTANDARD LVCMOS18 [get_ports pixel_clk]

